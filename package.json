{
  "name": "project-cupid",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build": "vite build",
    "start": "node dist/server.mjs --production",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "test:unit": "tsx tests/model.unit.test.ts",
    "test:rules": "firebase emulators:exec --config firebase.emulator.json --only firestore \"tsx tests/rules.emulator.test.ts\" --project studio-9165894196-8cf76",
    "test:server": "firebase emulators:exec --config firebase.emulator.json --only firestore,auth \"tsx tests/server.integration.test.ts\" --project studio-9165894196-8cf76",
    "test": "npm run lint && npm run test:unit && npm run test:rules && npm run test:server",
    "test:ui": "firebase emulators:exec --config firebase.emulator.json --only firestore,auth \"tsx tests/ui/mobile.audit.ts\" --project studio-9165894196-8cf76"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
