rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPartner() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['sanctuary_owner', 'partner', 'reader']);
    }

    function isAllowedUser() {
      return isAdmin() || isPartner();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role in ['sanctuary_owner', 'partner', 'reader'] || 
        (request.resource.data.role == 'admin' && request.auth.token.email in ['mraaziqp@gmail.com', 'backupe9@gmail.com'])
      );
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // App Collections - Love & Messages (Shared by Raaziq & Razia)
    match /letters/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /letter_replies/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /vault/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /message_boxes/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /daily_box_selections/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /reasons_vault/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /safe_space_items/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /timeline_moments/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /shared_moments/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /audio_memories/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /dream_board/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /future_letters/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /date_plans/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /marriage_traditions/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /time_capsules/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /love_vouchers/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /surprise_items/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /daily_acts/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Shared Wellness & Care
    match /weather/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /us_drops/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /care_quests/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /notifications/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Memory Book Scrapbook
    match /memory_book/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Daily Magical Welcome Persistence (Cross-device sync)
    match /daily_welcome_status/{docId} {
      allow read, write: if isSignedIn();
    }

    // Jarvis Ecosystem Audit Logs (Immutable audit trail)
    match /jarvis_audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // HER WELLBEING SANCTUARY — STRICT OWNER-ONLY PRIVACY
    // Raaziq's administrator role CANNOT bypass this.
    // Zero cross-account data leakage.
    // =========================================================================
    match /cycle_logs/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /wellbeing_symptoms/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /wellbeing_moods/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /wellbeing_medications/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /wellbeing_appointments/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /wellbeing_journal/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /wellbeing_settings/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == docId;
    }
  }
}
