rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // AUTHENTICATION & ROLE HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isCreatingOwnResource() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isUpdatingOwnResource() {
      return isSignedIn() && 
             resource.data.userId == request.auth.uid && 
             request.resource.data.userId == resource.data.userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPartner() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['sanctuary_owner', 'partner', 'reader']);
    }

    function isAllowedUser() {
      return isAdmin() || isPartner();
    }

    // =========================================================================
    // USERS & IDENTITY
    // Role privilege escalation is strictly prohibited.
    // =========================================================================
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role in ['sanctuary_owner', 'partner', 'reader'] || 
        (request.resource.data.role == 'admin' && request.auth.token.email in ['mraaziqp@gmail.com', 'backupe9@gmail.com'])
      );
      // Non-admins can update their profile but CANNOT self-escalate their role
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // APP COLLECTIONS — SHARED LOVE & MESSAGES (Raaziq & Razia)
    // =========================================================================
    match /letters/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /letter_replies/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /vault/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /message_boxes/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /daily_box_selections/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /reasons_vault/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /safe_space_items/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /timeline_moments/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /shared_moments/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /audio_memories/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /dream_board/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /future_letters/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /date_plans/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /marriage_traditions/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /time_capsules/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /love_vouchers/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /surprise_items/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /daily_acts/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Shared Wellness & Care
    match /weather/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /us_drops/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /care_quests/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /notifications/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Memory Book Scrapbook
    match /memory_book/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Daily Magical Welcome Persistence (Scoped to owning user)
    match /daily_welcome_status/{docId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Jarvis Ecosystem Audit Logs (Immutable, append-only audit trail)
    match /jarvis_audit_logs/{docId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.timestamp != null;
      allow update, delete: if false;
    }

    // =========================================================================
    // HER WELLBEING SANCTUARY — STRICT OWNER-ONLY PRIVACY (ZERO-LEAK GUARANTEE)
    // Raaziq's administrator role CANNOT bypass this.
    // Zero cross-account data leakage. Ownership cannot be transferred or forged.
    // =========================================================================
    match /cycle_logs/{docId} {
      allow get, list: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update: if isUpdatingOwnResource();
      allow delete: if isResourceOwner();
    }
    match /wellbeing_symptoms/{docId} {
      allow get, list: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update: if isUpdatingOwnResource();
      allow delete: if isResourceOwner();
    }
    match /wellbeing_moods/{docId} {
      allow get, list: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update: if isUpdatingOwnResource();
      allow delete: if isResourceOwner();
    }
    match /wellbeing_medications/{docId} {
      allow get, list: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update: if isUpdatingOwnResource();
      allow delete: if isResourceOwner();
    }
    match /wellbeing_appointments/{docId} {
      allow get, list: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update: if isUpdatingOwnResource();
      allow delete: if isResourceOwner();
    }
    match /wellbeing_journal/{docId} {
      allow get, list: if isResourceOwner();
      allow create: if isCreatingOwnResource();
      allow update: if isUpdatingOwnResource();
      allow delete: if isResourceOwner();
    }
    match /wellbeing_settings/{docId} {
      allow get, list, create, update, delete: if isOwner(docId);
    }
  }
}
