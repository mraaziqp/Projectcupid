rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isReader() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reader';
    }

    function isAllowedUser() {
      return isAdmin() || isReader();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role == 'reader' || 
        (request.resource.data.role == 'admin' && request.auth.token.email == 'backupe9@gmail.com')
      );
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // App Collections - Love & Messages
    match /letters/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /letter_replies/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /vault/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /message_boxes/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /daily_box_selections/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /reasons_vault/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /safe_space_items/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /timeline_moments/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /shared_moments/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /audio_memories/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /dream_board/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /future_letters/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /date_plans/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /marriage_traditions/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /time_capsules/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /love_vouchers/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /surprise_items/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /daily_acts/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Wellness & Care
    match /cycle_logs/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /weather/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /us_drops/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /care_quests/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /notifications/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Her Wellbeing Private Sanctuary - Strict User-Level Privacy
    match /wellbeing_symptoms/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /wellbeing_moods/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /wellbeing_medications/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /wellbeing_appointments/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /wellbeing_journal/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /wellbeing_settings/{docId} {
      allow read, write: if isAllowedUser();
    }
  }
}
