rules_version = '2';

// Project Cupid 5.0 security rules.
// Applies to the named database ai-studio-60c2955c-bef0-41d4-8dcc-ddbec95be891
// (and to (default), which the app does not use, so nothing there is reachable).
//
// Members are the accounts whose users/{uid}.role is admin, sanctuary_owner or
// partner. A role can only be created for the allowlisted Google accounts below
// and can never be changed by its owner. Everything not matched is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Identity ──────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() { return /databases/$(database)/documents/users/$(uid()); }
    function role() { return get(userDoc()).data.role; }
    function isMember() { return signedIn() && exists(userDoc()) && role() in ['admin', 'sanctuary_owner', 'partner']; }
    function isAdmin() { return signedIn() && exists(userDoc()) && role() == 'admin'; }

    function verifiedEmail() {
      return request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function allowlistedRole(r) {
      return verifiedEmail() && (
        (r == 'admin' && request.auth.token.email == 'mraaziqp@gmail.com') ||
        (r == 'sanctuary_owner' && request.auth.token.email == 'raziashade4@gmail.com')
      );
    }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }

    // ── Users ─────────────────────────────────────────────────────────────
    // role, email and the SaveState profile are written by the server only.
    match /users/{userId} {
      allow get: if signedIn() && (uid() == userId || isMember());
      allow list: if isMember();
      allow create: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'displayName'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && allowlistedRole(request.resource.data.role);
      allow update: if isMember() && uid() == userId
        && !changed().hasAny(['role', 'email', 'uid', 'savestate']);
      allow delete: if false;
    }

    // ── Shared space: both members read and write ─────────────────────────
    match /letters/{id} { allow read, write: if isMember(); }
    match /letter_replies/{id} { allow read, write: if isMember(); }
    match /vault/{id} { allow read, write: if isMember(); }
    match /message_boxes/{id} { allow read, write: if isMember(); }
    match /daily_box_selections/{id} { allow read, write: if isMember(); }
    match /reasons_vault/{id} { allow read, write: if isMember(); }
    match /safe_space_items/{id} { allow read, write: if isMember(); }
    match /timeline_moments/{id} { allow read, write: if isMember(); }
    match /shared_moments/{id} { allow read, write: if isMember(); }
    match /audio_memories/{id} { allow read, write: if isMember(); }
    match /dream_board/{id} { allow read, write: if isMember(); }
    match /future_letters/{id} { allow read, write: if isMember(); }
    match /date_plans/{id} { allow read, write: if isMember(); }
    match /marriage_traditions/{id} { allow read, write: if isMember(); }
    match /time_capsules/{id} { allow read, write: if isMember(); }
    match /love_vouchers/{id} { allow read, write: if isMember(); }
    match /surprise_items/{id} { allow read, write: if isMember(); }
    match /daily_acts/{id} { allow read, write: if isMember(); }
    match /weather/{id} { allow read, write: if isMember(); }
    match /us_drops/{id} { allow read, write: if isMember(); }
    match /care_quests/{id} { allow read, write: if isMember(); }
    match /memory_book/{id} { allow read, write: if isMember(); }

    // In-app notifications: the recipient reads and marks read; the server sends.
    match /notifications/{id} {
      allow get, list: if isMember() && (resource.data.userId == uid() || resource.data.senderId == uid());
      allow create: if isMember() && request.resource.data.senderId == uid();
      allow update: if isMember() && resource.data.userId == uid() && onlyChanges(['read']);
      allow delete: if isMember() && resource.data.userId == uid();
    }

    match /daily_welcome_status/{id} {
      allow get: if signedIn() && (resource == null || resource.data.userId == uid());
      allow list: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update: if signedIn() && resource.data.userId == uid() && request.resource.data.userId == uid();
      allow delete: if signedIn() && resource.data.userId == uid();
    }

    // ── Append-only logs (written by the server) ──────────────────────────
    match /jarvis_audit_logs/{id} { allow get, list: if isAdmin(); allow write: if false; }
    match /jarvis_events/{id} { allow get, list: if isAdmin(); allow write: if false; }
    match /notificationLogs/{id} { allow get, list: if isAdmin(); allow write: if false; }
    match /ecosystem_log/{id} { allow get, list: if isAdmin(); allow write: if false; }
    match /import_history/{id} { allow get, list: if isMember(); allow write: if false; }
    match /ecosystem_state/{id} { allow get: if isAdmin(); allow write: if false; }

    // Server-only: account links, encrypted SaveState sessions, limits, config.
    match /identity_links/{id} { allow read, write: if false; }
    match /integration_secrets/{id} { allow read, write: if false; }
    match /rate_limits/{id} { allow read, write: if false; }
    match /integration_config/{id} { allow read, write: if false; }
    match /integration_links/{id} { allow get: if isMember() && id.matches('.*_' + uid()); allow write: if false; }

    // Jarvis proposals: shown to the memory's owner; decided through the server.
    match /jarvis_proposals/{id} {
      allow get, list: if isMember() && resource.data.memoryOwnerId == uid();
      allow write: if false;
    }

    // ── Her Wellbeing: owner only. Admin does not bypass this. ────────────
    function ownsExisting() { return signedIn() && resource.data.userId == uid(); }
    function createsOwn() { return signedIn() && request.resource.data.userId == uid(); }
    function keepsOwner() { return ownsExisting() && request.resource.data.userId == resource.data.userId; }

    match /cycle_logs/{id} { allow get, list, delete: if ownsExisting(); allow create: if createsOwn(); allow update: if keepsOwner(); }
    match /wellbeing_symptoms/{id} { allow get, list, delete: if ownsExisting(); allow create: if createsOwn(); allow update: if keepsOwner(); }
    match /wellbeing_moods/{id} { allow get, list, delete: if ownsExisting(); allow create: if createsOwn(); allow update: if keepsOwner(); }
    match /wellbeing_medications/{id} { allow get, list, delete: if ownsExisting(); allow create: if createsOwn(); allow update: if keepsOwner(); }
    match /wellbeing_appointments/{id} { allow get, list, delete: if ownsExisting(); allow create: if createsOwn(); allow update: if keepsOwner(); }
    match /wellbeing_journal/{id} { allow get, list, delete: if ownsExisting(); allow create: if createsOwn(); allow update: if keepsOwner(); }
    match /wellbeing_settings/{userId} { allow get, list, create, update, delete: if signedIn() && uid() == userId; }

    // ── Memory Garden ─────────────────────────────────────────────────────
    function memoryPath(id) { return /databases/$(database)/documents/memories/$(id); }
    function canSeeMemory(m) { return m.visibility == 'shared' || m.ownerId == uid(); }

    function validMemoryFields(d) {
      return d.title is string && d.title.size() <= 120
        && d.caption is string && d.caption.size() <= 4000
        && d.memoryDate is string && d.memoryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.datePrecision in ['day', 'month', 'year']
        && d.visibility in ['shared', 'private']
        && d.status in ['inbox', 'organised', 'archived']
        && d.tags is list && d.tags.size() <= 12
        && d.collectionIds is list && d.collectionIds.size() <= 30
        && d.favouritedBy is list && d.favouritedBy.size() <= 4
        && d.isSpecialOccasion is bool
        && (d.location == null || (d.location is string && d.location.size() <= 120))
        && (d.thumbnail == null || (d.thumbnail is string && d.thumbnail.size() <= 120000 && d.thumbnail.matches('^data:image/(jpeg|webp|png);base64,.*')));
    }

    match /memories/{id} {
      allow get: if isMember() && canSeeMemory(resource.data);
      // Queries must ask for shared memories or the caller's own.
      allow list: if isMember() && canSeeMemory(resource.data);

      // Text-only memories from the app. Anything with media, or imported, is created by the server.
      allow create: if isMember()
        && request.resource.data.ownerId == uid()
        && request.resource.data.source == 'cupid'
        && request.resource.data.media == []
        && request.resource.data.mediaType in ['text', 'letter']
        && request.resource.data.favouritedBy == []
        && validMemoryFields(request.resource.data)
        && request.resource.data.keys().hasOnly(['ownerId', 'visibility', 'title', 'caption', 'memoryDate', 'datePrecision', 'mediaType', 'media', 'thumbnail', 'tags', 'location', 'collectionIds', 'favouritedBy', 'isSpecialOccasion', 'status', 'source', 'sourceRecordId', 'provenance', 'lastOpenedAt', 'createdAt', 'updatedAt']);

      // The owner edits their memory; where it came from never changes.
      allow update: if isMember() && resource.data.ownerId == uid()
        && !changed().hasAny(['ownerId', 'source', 'sourceRecordId', 'provenance', 'media', 'createdAt'])
        && validMemoryFields(request.resource.data);

      // The partner, on a shared memory, may favourite it for themself, open it, and file it in collections.
      allow update: if isMember() && resource.data.visibility == 'shared' && resource.data.ownerId != uid()
        && onlyChanges(['favouritedBy', 'lastOpenedAt', 'collectionIds', 'updatedAt'])
        && request.resource.data.favouritedBy.toSet().difference(resource.data.favouritedBy.toSet()).hasOnly([uid()])
        && resource.data.favouritedBy.toSet().difference(request.resource.data.favouritedBy.toSet()).hasOnly([uid()])
        && validMemoryFields(request.resource.data);

      allow delete: if false; // through the server, which also tidies media and perspectives
    }

    // Two Perspectives: one per person per memory; shared only when its author says so.
    match /memory_perspectives/{id} {
      allow get, list: if isMember() && (resource.data.authorId == uid()
        || (resource.data.shared == true && get(memoryPath(resource.data.memoryId)).data.visibility == 'shared'));
      allow create, update: if isMember()
        && id == request.resource.data.memoryId + '_' + uid()
        && request.resource.data.authorId == uid()
        && request.resource.data.shared is bool
        && request.resource.data.text is string && request.resource.data.text.size() <= 4000
        && exists(memoryPath(request.resource.data.memoryId))
        && canSeeMemory(get(memoryPath(request.resource.data.memoryId)).data)
        && (resource == null || resource.data.authorId == uid());
      allow delete: if isMember() && resource.data.authorId == uid();
    }

    // Reactions and little notes, on shared memories.
    match /memory_reactions/{id} {
      allow get, list: if isMember() && canSeeMemory(get(memoryPath(resource.data.memoryId)).data);
      allow create, update: if isMember()
        && id == request.resource.data.memoryId + '_' + uid()
        && request.resource.data.userId == uid()
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
        && (request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 280))
        && exists(memoryPath(request.resource.data.memoryId))
        && get(memoryPath(request.resource.data.memoryId)).data.visibility == 'shared';
      allow delete: if isMember() && resource.data.userId == uid();
    }

    // Collections: shared ones belong to both; private ones to their owner.
    match /memory_collections/{id} {
      allow get, list: if isMember() && (resource.data.visibility == 'shared' || resource.data.ownerId == uid());
      allow create: if isMember() && request.resource.data.ownerId == uid()
        && request.resource.data.visibility in ['shared', 'private']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 300));
      allow update: if isMember()
        && (resource.data.ownerId == uid() || resource.data.visibility == 'shared')
        && !changed().hasAny(['ownerId', 'visibility', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow delete: if isMember() && resource.data.ownerId == uid();
    }

    // Each person's daily pick (so "show me another" is remembered).
    match /daily_memory/{id} {
      allow get, list: if signedIn() && resource.data.userId == uid();
      allow create, update: if isMember() && request.resource.data.userId == uid() && id.matches('^' + uid() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if false;
    }
  }
}
