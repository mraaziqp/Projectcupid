{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role management.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "reader"] },
        "photoURL": { "type": "string" },
        "displayName": { "type": "string" },
        "fcmToken": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Letter": {
      "title": "Letter",
      "description": "Love letters between partners.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "publishDate": { "type": "string", "format": "date-time" },
        "isPublished": { "type": "boolean" },
        "isFavorite": { "type": "boolean" },
        "isRead": { "type": "boolean" },
        "authorId": { "type": "string" },
        "authorRole": { "type": "string" },
        "recipientRole": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "publishDate", "isPublished", "authorId"]
    },
    "MessageBox": {
      "title": "Message Box",
      "description": "Our Little Message Boxes for daily surprises and notes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "category": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "isSecret": { "type": "boolean" },
        "isOpened": { "type": "boolean" },
        "isFavorite": { "type": "boolean" },
        "cycleNumber": { "type": "number" },
        "scheduledDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "authorId", "category", "isOpened"]
    },
    "DailyBoxSelection": {
      "title": "Daily Box Selection",
      "description": "Consistent atomic daily selected message box.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "messageId": { "type": "string" },
        "secondMessageId": { "type": "string" },
        "isOpened": { "type": "boolean" },
        "selectedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "messageId", "isOpened"]
    },
    "ReasonVault": {
      "title": "365 Reason Vault Item",
      "description": "Daily reasons why we appreciate and love each other.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dayNumber": { "type": "number" },
        "text": { "type": "string" },
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "isFavorite": { "type": "boolean" }
      },
      "required": ["dayNumber", "text", "author"]
    },
    "TimelineMoment": {
      "title": "Timeline Moment",
      "description": "Our Story relationship milestone.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "photoUrl": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["date", "title", "description"]
    },
    "DreamBoard": {
      "title": "Dream Board Item",
      "description": "Shared dreams, goals, and dreams that cost nothing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "isCostNothing": { "type": "boolean" },
        "progress": { "type": "number" },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["title", "category"]
    },
    "DatePlan": {
      "title": "Date Plan",
      "description": "Date ideas and planner.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["title", "category"]
    },
    "LoveVoucher": {
      "title": "Love Voucher",
      "description": "Digital redeemable love voucher.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "creatorId": { "type": "string" },
        "isRedeemed": { "type": "boolean" }
      },
      "required": ["title", "creatorId", "isRedeemed"]
    },
    "TimeCapsule": {
      "title": "Time Capsule",
      "description": "Annual marriage anniversary reflections sealed in time.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "yearNumber": { "type": "number" },
        "title": { "type": "string" },
        "anniversaryDate": { "type": "string" },
        "isSealed": { "type": "boolean" },
        "unlockDate": { "type": "string" }
      },
      "required": ["yearNumber", "title", "anniversaryDate", "isSealed"]
    },
    "WellbeingSymptom": {
      "title": "Wellbeing Symptom",
      "description": "Private symptom log (physical and emotional).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "symptomName": { "type": "string" },
        "severity": { "type": "number" }
      },
      "required": ["userId", "date", "category", "symptomName", "severity"]
    },
    "WellbeingMood": {
      "title": "Wellbeing Mood",
      "description": "Private daily mood and energy log.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "moodScore": { "type": "number" },
        "energyLevel": { "type": "number" }
      },
      "required": ["userId", "date", "moodScore"]
    },
    "WellbeingMedication": {
      "title": "Wellbeing Medication",
      "description": "Private medication and supplement tracker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "dosage": { "type": "string" },
        "frequency": { "type": "string" }
      },
      "required": ["userId", "name", "dosage"]
    },
    "WellbeingAppointment": {
      "title": "Wellbeing Appointment",
      "description": "Private doctor appointment notes and question preparation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "providerName": { "type": "string" },
        "specialty": { "type": "string" }
      },
      "required": ["userId", "appointmentDate", "providerName"]
    }
  },
  "firestore": {
    "users": { "schema": "User" },
    "letters": { "schema": "Letter" },
    "message_boxes": { "schema": "MessageBox" },
    "daily_box_selections": { "schema": "DailyBoxSelection" },
    "reasons_vault": { "schema": "ReasonVault" },
    "timeline_moments": { "schema": "TimelineMoment" },
    "dream_board": { "schema": "DreamBoard" },
    "date_plans": { "schema": "DatePlan" },
    "love_vouchers": { "schema": "LoveVoucher" },
    "time_capsules": { "schema": "TimeCapsule" },
    "cycle_logs": { "schema": "CycleLog" },
    "wellbeing_symptoms": { "schema": "WellbeingSymptom" },
    "wellbeing_moods": { "schema": "WellbeingMood" },
    "wellbeing_medications": { "schema": "WellbeingMedication" },
    "wellbeing_appointments": { "schema": "WellbeingAppointment" }
  }
}
