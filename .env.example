# Project Cupid 5.0 — environment variables.
# Production values live in Vercel (Project → Settings → Environment Variables),
# marked Sensitive. Locally, put real values in .env.local (gitignored). Never commit secrets.
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ── Firebase ───────────────────────────────────────────────────────────────
# Service account JSON (one line) for project studio-9165894196-8cf76.
# Needed for every API route: auth checks, SaveState sign-in tokens, push, Memory Garden.
FIREBASE_SERVICE_ACCOUNT=
# Web push public key (Firebase Console → Cloud Messaging → Web Push certificates). Build-time.
VITE_FIREBASE_VAPID_KEY=

# ── SaveState (sign-in, photos, mail) ──────────────────────────────────────
SAVESTATE_URL=https://savestate.co.za
# Encrypts each member's SaveState session at rest. Random, 32+ chars. (Also accepts ENCRYPTION_SECRET)
CUPID_SESSION_SECRET=
ENCRYPTION_SECRET=
# PIN that locks Cupid's own album in SaveState's photo booklet. Random, 16+ chars.
CUPID_SAVESTATE_ALBUM_PIN=
# Optional pre-approved links: {"<SaveState user id>":"<Cupid member email>"}.
# Without it, each member links once from Settings → SaveState.
CUPID_SAVESTATE_LINKS=

# ── Mail fallback (used only when SaveState's mail relay can't send) ───────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Project Cupid <cupid@savestate.co.za>

# ── AI letter drafting ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback
OLLAMA_API_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3

# ── Jarvis (Second Brain) ──────────────────────────────────────────────────
JARVIS_URL=https://jarvis.savestate.co.za
# Cupid's own integration key in Jarvis (jb_live_sk_…, permissions ingest_events + read_logs).
JARVIS_ECOSYSTEM_KEY=
# Key Jarvis must present to call Cupid's tools (/api/jarvis/*). Random, 32+ chars.
JARVIS_API_KEY=
# Key other ecosystem apps present on the inbound Memory Book bridge. Random, 32+ chars.
BRIDGE_SECRET=

# ── WeddingApp (read-only source for the Memory Garden) ────────────────────
# Its public media API needs no key.
WEDDINGAPP_URL=https://www.raziaraaziq.co.za

# ── Operations ─────────────────────────────────────────────────────────────
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/daily. Random, 32+ chars.
CRON_SECRET=
# The ESP32 Love Lamp's key for /api/lamp/status (unread count only). Random, 32+ chars.
CUPID_LAMP_KEY=
CUPID_PUBLIC_URL=https://cupid.raziaraaziq.co.za
